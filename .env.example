# Public base URL of the Burbot Business Driver API.
# Leave empty when the frontend and API share the same domain and /api is proxied.
VITE_API_BASE_URL=
# Development-only Vite proxy target (not embedded in the browser bundle).
BURBOT_API_TARGET=http://localhost:8000
# Optional development-only gateway that authorizes the Studio user and serves GET /monitoring/reviews/{id}.
BURBOT_REVIEW_GATEWAY=
